DOMAIN=scoring.example.com

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

ADMIN_PASSWORD=change-me-to-a-strong-password-of-at-least-16-chars

# Optional: restrict CORS to this origin (e.g. https://scoring.example.com).
# Leave empty when the frontend is served from the same origin as the API (normal Caddy setup).
FRONTEND_ORIGIN=
